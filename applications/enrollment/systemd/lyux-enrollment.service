[Unit]
Description=LyuX First-Boot OOBE Setup (serveur, batiment, salle, compte admin)
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Before=display-manager.service sddm.service
Conflicts=getty@tty1.service
ConditionPathExists=/etc/lyux/first-boot.flag

[Service]
Type=oneshot
# Chaque carte sans IP reçoit un bail DHCP avant la découverte du serveur.
ExecStartPre=/bin/bash /opt/lyux/apps/enrollment/scripts/lyux-net-setup.sh
ExecStart=/usr/bin/xinit /bin/bash /opt/lyux/apps/enrollment/scripts/lyux-oobe-session.sh /opt/lyux/apps/enrollment/src/oobe_gui.py -- :0 vt1 -nolisten tcp
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console
TTYPath=/dev/tty1
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
